# Copie para .env (NUNCA envie o .env para o Git) e exporte as variáveis no servidor.
PORT=3000
# Chave da Anthropic (obrigatória para a IA). Fica só no servidor.
ANTHROPIC_API_KEY=
# Modelo padrão e lista permitida (separada por vírgula)
CLAUDE_MODEL=claude-sonnet-5-5
ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5
# Chave do Brave Search API (obrigatória para a pesquisa web)
BRAVE_API_KEY=
# Origens permitidas por CORS (vazio = apenas mesma origem)
ALLOWED_ORIGINS=
# Código de acesso opcional: se definido, a API exige o cabeçalho x-access-code
ACCESS_CODE=
# Requisições por minuto por IP
RATE_LIMIT_PER_MIN=30
